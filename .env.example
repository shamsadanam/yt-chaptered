# Cloudflare Turnstile Configuration
# If omitted in development, official Cloudflare dummy test keys will be used automatically.
# In production, set your actual Site Key and Secret Key from the Cloudflare Dashboard.

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Web Analytics
# Web analytics beacon token (only injected in production builds).
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
